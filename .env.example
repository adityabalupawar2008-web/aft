# ==============================================================================
# API FAILURE TWIN - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Browser-Accessible Public Variables (Safe for client-side JavaScript)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Server-Side Only Variables (NEVER expose to client code or prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-service-role-key-here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
